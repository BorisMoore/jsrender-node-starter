{
  "name": "jsrender-node-starter",
  "version": "1.2.0",
  "description": "Starter app for JsRender server-rendered templates on Node.js using Express 4 or Hapi, and optionally Browserify and JsRenderify",
  "main": "index-express.js",
  "scripts": {
    "start": "node index-express.js",
    "helloworld": "node index-helloworld.js",
    "express": "node index-express.js",
    "hapi": "node index-hapi.js",
    "express-b": "node index-express-browserify.js",
    "express-b2": "node index-express-browserify2.js",
    "hapi-b": "node index-hapi-browserify.js",
    "bundle": "node ./browserify/makebundle.js"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "browserify": "^17.0.0",
    "express": "^5.2.1",
    "@hapi/hapi": "^21.4.9",
    "@hapi/inert": "^7.1.2",
    "@hapi/vision":  "^7.0.3",
    "jquery": "^4.0.0",
    "jsrender": "^1.2.0",
    "jsviews": "^1.2.0",
    "serve-favicon": "^2.5.1",
    "through2": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BorisMoore/jsrender-node-starter"
  },
  "keywords": [
    "jsrender",
    "jsviews",
    "templates",
    "node",
    "express",
    "hapi",
    "browserify",
    "jsrenderify",
    "heroku"
  ],
  "license": "MIT",
  "devDependencies": {}
}
